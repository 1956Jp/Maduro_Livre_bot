# Copia de ejemplo. Renombra a .env y rellena tus valores reales.
# NO subas .env a ningun repositorio.

# Token del bot de Telegram (@jose129_bot)
TELEGRAM_TOKEN=

# Clave del proveedor de IA (compatible con la API de OpenAI)
API_KEY=

# Endpoint del proveedor. Ejemplos:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI:     https://api.openai.com/v1
#   Ollama:     http://localhost:11434/v1
API_BASE_URL=https://api.groq.com/openai/v1

# Modelo a usar (depende del proveedor).
#   Groq:       llama-3.3-70b-versatile
#   OpenRouter: meta-llama/llama-3.3-70b-instruct
#   Ollama:     gemma4:e2b
MODEL=llama-3.3-70b-versatile
